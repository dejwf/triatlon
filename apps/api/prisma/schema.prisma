// Datový model systému pro Vlkančický triatlon — viz CLAUDE.md, sekce 4.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  super_admin
  admin
  organizer
}

enum RaceStatus {
  planned
  running
  finished
}

enum Gender {
  male
  female
}

enum Locality {
  local
  guest
}

enum ParticipantStatus {
  registered
  checked_in
  absent
  disqualified
}

enum RegistrationSource {
  manual
  import
  online
  on_site
}

enum CheckpointKind {
  transition // hranice disciplíny (start, konec plavání, konec kola, cíl)
  intermediate // sub-checkpoint uvnitř disciplíny — TBD, zatím se nepoužívá
}

enum TimeEventType {
  record
  cancel
  note
  admin_correction
}

model User {
  id          String       @id @default(uuid()) @db.Uuid
  email       String       @unique
  name        String
  role        UserRole     @default(organizer)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  assignments Assignment[]
  loginTokens LoginToken[]
  sessions    Session[]
  timeEvents  TimeEvent[]
}

/// Jednorázový token pro přihlášení magic linkem (v DB jen hash) + 6místný kód pro mobil.
model LoginToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// Dlouhodobá session (refresh token, v DB jen hash) — organizátor nemá být odhlášen v den závodu bez signálu.
model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash String    @unique
  deviceId    String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

model Race {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  year        Int
  date        DateTime      @db.Date
  status      RaceStatus    @default(planned)
  /// Konfigurovatelné věkové skupiny: [{ label, minAge, maxAge|null }]
  ageGroups   Json
  createdAt   DateTime      @default(now())
  categories  Category[]
  disciplines Discipline[]
  checkpoints Checkpoint[]
  participants Participant[]
  assignments Assignment[]

  @@unique([name, year])
}

model Category {
  id            String               @id @default(uuid()) @db.Uuid
  raceId        String               @db.Uuid
  race          Race                 @relation(fields: [raceId], references: [id], onDelete: Cascade)
  name          String
  ageGroupLabel String
  /// Rozsah ročníků narození (dopočteno z věkové skupiny a roku závodu); null = bez hranice.
  birthYearFrom Int?
  birthYearTo   Int
  gender        Gender
  locality      Locality
  /// Délky tratí pro tempo, např. { swim: 100, bike: 5000, run: 1000 } v metrech.
  distances     Json?
  /// Čas hromadného startu kategorie (pro zobrazení uplynulého času); per-závodník start je v TimeEvent.
  startedAt     DateTime?
  participants  Participant[]
  checkpoints   CategoryCheckpoint[]
  rankingOverrides RankingOverride[]

  @@unique([raceId, ageGroupLabel, gender, locality])
  @@index([raceId])
}

model Discipline {
  id          String       @id @default(uuid()) @db.Uuid
  raceId      String       @db.Uuid
  race        Race         @relation(fields: [raceId], references: [id], onDelete: Cascade)
  name        String // plavání, cyklistika, běh
  seq         Int
  checkpoints Checkpoint[]

  @@unique([raceId, seq])
}

model Checkpoint {
  id           String               @id @default(uuid()) @db.Uuid
  raceId       String               @db.Uuid
  race         Race                 @relation(fields: [raceId], references: [id], onDelete: Cascade)
  name         String
  seq          Int
  kind         CheckpointKind       @default(transition)
  /// Disciplína, kterou checkpoint ukončuje (transition) nebo do které patří (intermediate); null = start.
  disciplineId String?              @db.Uuid
  discipline   Discipline?          @relation(fields: [disciplineId], references: [id])
  categories   CategoryCheckpoint[]
  assignments  Assignment[]
  timeEvents   TimeEvent[]

  @@unique([raceId, seq])
}

/// Které checkpointy platí pro kterou kategorii (+ volitelně očekávaná vzdálenost od startu).
model CategoryCheckpoint {
  categoryId   String     @db.Uuid
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  checkpointId String     @db.Uuid
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)
  distanceM    Int?

  @@id([categoryId, checkpointId])
}

model Participant {
  id                 String             @id @default(uuid()) @db.Uuid
  raceId             String             @db.Uuid
  race               Race               @relation(fields: [raceId], references: [id], onDelete: Cascade)
  categoryId         String             @db.Uuid
  category           Category           @relation(fields: [categoryId], references: [id])
  /// Startovní číslo — unikátní jen v rámci kategorie.
  bib                Int
  firstName          String
  lastName           String
  birthYear          Int
  gender             Gender
  locality           Locality
  status             ParticipantStatus  @default(registered)
  registrationSource RegistrationSource @default(manual)
  createdAt          DateTime           @default(now())
  timeEvents         TimeEvent[]

  @@unique([categoryId, bib])
  @@index([raceId])
}

/// Přiřazení organizátora k závodu a checkpointu — určuje, co smí v appce zapisovat.
model Assignment {
  id           String     @id @default(uuid()) @db.Uuid
  userId       String     @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  raceId       String     @db.Uuid
  race         Race       @relation(fields: [raceId], references: [id], onDelete: Cascade)
  checkpointId String     @db.Uuid
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@unique([userId, checkpointId])
  @@index([raceId])
}

/// Append-only log akcí na checkpointech. `id` generuje klient → idempotentní zápis.
/// Nikdy se nepřepisuje ani nemaže; zrušení/korekce = nová událost s refEventId.
model TimeEvent {
  id               String        @id @db.Uuid
  type             TimeEventType
  participantId    String        @db.Uuid
  participant      Participant   @relation(fields: [participantId], references: [id])
  checkpointId     String        @db.Uuid
  checkpoint       Checkpoint    @relation(fields: [checkpointId], references: [id])
  /// Čas akce (na klientovi, opravený o offset hodin vůči serveru).
  ts               DateTime      @db.Timestamptz(3)
  note             String?
  refEventId       String?       @db.Uuid
  refEvent         TimeEvent?    @relation("EventRef", fields: [refEventId], references: [id])
  referencedBy     TimeEvent[]   @relation("EventRef")
  reason           String?
  userId           String        @db.Uuid
  user             User          @relation(fields: [userId], references: [id])
  deviceId         String
  serverReceivedAt DateTime      @default(now()) @db.Timestamptz(3)

  @@index([participantId, checkpointId])
  @@index([checkpointId])
}

/// Ruční určení pořadí adminem (nerozhodný/sporný výsledek), vždy s důvodem.
model RankingOverride {
  id             String   @id @default(uuid()) @db.Uuid
  categoryId     String   @db.Uuid
  category       Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Seřazené ID závodníků, kterých se rozhodnutí týká.
  participantIds String[] @db.Uuid
  reason         String
  userId         String   @db.Uuid
  createdAt      DateTime @default(now())
  supersededAt   DateTime?
}

/// Obecný auditní log administrativních změn (kdo, kdy, co, proč).
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  reason    String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
