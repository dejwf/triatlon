# SITE_ADDRESS = doména (např. vysledky.vlkancice.cz) → Caddy sám získá a obnovuje HTTPS
# certifikát (Let's Encrypt). Bez domény (":80") běží jen HTTP — pro test na lokální síti.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		# flush_interval -1: živé výsledky (SSE) se posílají hned, bez bufferování.
		reverse_proxy api:3000 {
			flush_interval -1
		}
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
}
