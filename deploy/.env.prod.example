# Produkční konfigurace — zkopírujte na .env.prod (necommitovat!) a vyplňte.

# Doména webu. Caddy pro ni automaticky získá HTTPS certifikát (DNS musí mířit na server,
# porty 80 a 443 otevřené). Pro zkoušku bez domény: SITE_ADDRESS=:80 a WEB_URL=http://<IP>
SITE_ADDRESS=vysledky.example.cz
WEB_URL=https://vysledky.example.cz

# Databáze
POSTGRES_USER=triatlon
POSTGRES_PASSWORD=zmente-na-dlouhe-nahodne-heslo
POSTGRES_DB=triatlon

# Podpis přihlášení — dlouhý náhodný řetězec: openssl rand -base64 48
AUTH_SECRET=

# E-maily s přihlašovacím kódem (SMTP poskytovatel v EU, např. port 587 + přihlášení)
SMTP_HOST=smtp.example.cz
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Vlkančický triatlon <noreply@example.cz>"

# První admin (vytvoří ho seed — viz README)
SEED_ADMIN_EMAIL=

# Správce osobních údajů pro stránku /ochrana-osobnich-udaju (zapéká se do webu při buildu)
ORGANIZER_NAME="Spolek …, IČO …, adresa …"
ORGANIZER_CONTACT=info@example.cz

# Zálohy: interval v sekundách (den závodu klidně 900 = 15 min) a kolik dní je držet
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_DAYS=14
